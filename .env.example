# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/campus-resource-hub
# Vercel automatically uses this same MongoDB database for Socket.IO
# cross-instance broadcasts; no separate Redis service is required.

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration (Required for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL
CLIENT_URL=http://localhost:5173

# AI provider chain — assistant, upload moderation and file/vision reading.
# Providers are tried in order, preferred one first; a provider with no key
# configured is skipped entirely, so deleting a key removes that provider.
#
# Any key variable may hold SEVERAL keys, comma separated:
#   GROQ_API_KEY=gsk_first,gsk_second
# They are used left to right. A key that answers 401/402/403/429 is spent or
# rejected, so it is benched for 10 minutes and the next key of the same
# provider is used before falling through to a different provider.
AI_PROVIDER=groq

# Groq (free developer limits)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face Inference Providers (set AI_PROVIDER=huggingface to prefer)
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_MODEL=openai/gpt-oss-20b
HUGGINGFACE_VISION_MODEL=zai-org/GLM-4.5V

# OpenAI — optional. Leave unset to drop it from the chain.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1-mini

# File Upload Configuration
MAX_FILE_SIZE=52428800

# Email / OTP Configuration
# In development, OTP emails are printed to the backend console if SMTP is not configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=demo@gmail.com
SMTP_PASS=A1223344313
MAIL_FROM="Campus Resource Hub <demo@gmail.com>"
# Optional Groq safety models. Text has a maintained default. Set the vision
# model only after confirming it appears in GET /openai/v1/models for your key.
GROQ_TEXT_GUARD_MODEL=openai/gpt-oss-safeguard-20b
GROQ_VISION_GUARD_MODEL=qwen/qwen3.6-27b
# Disable the local ONNX embedding model in memory-constrained/serverless hosts.
EMBEDDINGS_DISABLED=0
# setImmediate background work is disabled on Vercel unless explicitly enabled.
ENABLE_BACKGROUND_INDEXING=0
